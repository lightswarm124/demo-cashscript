
pragma cashscript ^0.11.0;

// 2 players bet on the price of BCH at a given timestamp:
// - alice and bob each add the same amount of money to the pot
// - alice and bob agree on a target price and timestamp
// - if the price of BCH is higher than the target price at the given timestamp, alice wins
// - if the price of BCH is lower than or equal to the target price at the given timestamp, bob wins

// With the specified parameters, alice should have won the bet, but how can you (bob) scam alice out of her rightful victory?
contract PriceBet(
    // 0251c40ae31baccec147cb9f04f8be7137f1cbed407b2be9a90985c980af005594 = random wallet of the other player
    pubkey alicePublicKey,
    // pubkey bobPublicKey, NOTE: we removed this for the challenge so that anyone can assume the role of bob
    // 1752658200 = 2025-07-16 9:30:00 UTC
    int timestamp,
    // 50000 = 500.00 USD
    int targetPrice,
    // 02d09db08af1ff4e8453919cc866a4be427d7bfe18f2c05e5444c196fcf6fd2818 = General Protocols BCH/USD oracle
    pubkey oraclePublicKey,
) {
    function payout(
        sig playerSignature,
        bytes oracleMessage,
        datasig oracleSignature,
    ) {
        // check that the oracle signed the message
        require(checkDataSig(oracleSignature, oracleMessage, oraclePublicKey));

        // extract the relevant oracle data
        // oracle message format: { bytes4 timestamp, bytes4 messageSequence, bytes4 contentSequence, bytes4 price }
        int oracleTimestamp = int(oracleMessage.split(4)[0]);
        int oraclePrice = int(oracleMessage.split(12)[1]);

        // check that the timestamp was reached
        require(oracleTimestamp > timestamp);

        // Iif the oraclePrice is greater than the targetPrice, then alice can claim the money
        if (oraclePrice > targetPrice) {
            require(checkSig(playerSignature, alicePublicKey));
        // else bob can claim the money
        } else {
            // NOTE: we've removed this check for the challenge so that anyone can assume the role of bob
            // require(checkSig(playerSignature, bobPublicKey));
        }
    }
}